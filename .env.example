# Contract Manager — environment variables (plan section 83).
#
# Copy to .env.local for development:
#     cp .env.example .env.local
#
# NEVER commit .env.local. It is already in .gitignore.
# Values below are placeholders; the real ones come from the two dashboards.

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=

# Safe for the browser (client + server).
# Current format: sb_publishable_...   Legacy equivalent: the anon key (JWT).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never import it into client
# code — anything that reaches a Client Component ends up in the browser bundle.
# Current format: sb_secret_...        Legacy equivalent: the service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Local development:    http://localhost:3000
# Production (Vercel):  https://cm.hrpartner.vn
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------

# Enforced by PresignUploadSchema (packages/schemas/file.ts). Server-side only —
# it has no NEXT_PUBLIC_ prefix, so a Client Component sees the 50 MB fallback
# and the server stays authoritative.
MAX_UPLOAD_SIZE_MB=50

# ---------------------------------------------------------------------------
# Cloudflare R2 — the PRIVATE bucket holding contract PDF/JPG/PNG files.
#
# All five values are server-only: lib/r2/* imports `server-only`, so the build
# fails if a Client Component ever reaches them. See plan sections 36-41, 61.
#
# The bucket name is configuration, but the object key prefix is always
# "contracts/..." regardless of the bucket name (plan section 37).
#
# The bucket MUST carry a CORS policy allowing GET, HEAD and PUT from the app
# origin, or the in-app PDF viewer (pdf.js) and the browser upload both fail.
# See README → Deployment.
# ---------------------------------------------------------------------------

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# e.g. https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# ---------------------------------------------------------------------------
# Tests (required for `pnpm test:integration` and `pnpm test:e2e`)
# ---------------------------------------------------------------------------
#
# `pnpm test` (unit) needs none of these. The two live suites read .env.local
# exactly like the app does, plus the two values below — they sign in as a real
# account and have NO fallback, so they skip themselves when these are missing
# rather than failing or, worse, carrying a credential in source.
#
# Never commit real values: .env.local is gitignored, and that is the only place
# these belong.

TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
