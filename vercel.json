{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["icn1"],
  "functions": {
    "app/**/*": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/storage-cleanup",
      "schedule": "0 2 * * *"
    }
  ],
  "github": {
    "silent": true
  }
}
